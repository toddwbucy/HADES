#!/usr/bin/env bash
# Select one active and persistently enabled HADES embedder profile.
# Usage: hades-embedder-profile [show|list|PROFILE]
set -euo pipefail

PROFILE_DIR="${HOME}/.config/hades/embedder-profiles"
UNIT_PREFIX="hades-embedder@"
ENDPOINT="http://127.0.0.1:8087/v1/models"
READY_TIMEOUT="${HADES_PROFILE_READY_TIMEOUT:-120}"

# Metadata confirms which profile answers, not that inference has succeeded.
PARSE_MODELS='
import json, sys
item = json.load(sys.stdin)["data"][0]
if len(sys.argv) > 1:
    if item.get("profile") != sys.argv[1]:
        raise ValueError("wrong profile")
    for key in ("max_seq_length", "dimension"):
        if type(item.get(key)) is not int or item[key] <= 0:
            raise ValueError(key)
print("  metadata: profile=%s card=%s max_seq_length=%s dimension=%s (inference not tested)"
      % (item.get("profile", "?"), item.get("physical_device") or item.get("device", "?"),
         item.get("max_seq_length", "?"), item.get("dimension", "?")))
'

active_units() {
  systemctl --user list-units --state=active,activating,deactivating,reloading \
    --plain --no-legend "${UNIT_PREFIX}*.service" | awk '{print $1}'
}

enabled_units() {
  systemctl --user list-unit-files --state=enabled,enabled-runtime \
    --no-legend "${UNIT_PREFIX}*.service" | awk '{print $1, $2}'
}

show_active() {
  local active enabled
  active="$(active_units)"
  enabled="$(enabled_units)"
  printf 'active profiles:\n%s\npersistent/runtime enablement:\n%s\n' "${active:-none}" "${enabled:-none}"
  if [[ -n "$active" ]]; then
    curl -sf -m 3 "$ENDPOINT" | python3 -c "$PARSE_MODELS" \
      || echo '  metadata unavailable; inspect the selected unit journal'
  fi
}

case "${1:-show}" in
  show) show_active; exit ;;
  list)
    shopt -s nullglob
    for conf in "$PROFILE_DIR"/*.conf; do
      name="$(basename "$conf" .conf)"
      card="$(sed -n 's/^CUDA_VISIBLE_DEVICES=//p' "$conf")"
      ceiling="$(sed -n 's/^HADES_EMBEDDER_MAX_TOKENS=//p' "$conf")"
      batch="$(sed -n 's/^HADES_EMBEDDER_BATCH_SIZE=//p' "$conf")"
      printf '%-6s card=%s ceiling=%s batch=%s\n' "$name" "$card" "$ceiling" "$batch"
    done
    exit ;;
esac

if [[ $# != 1 || ! "$1" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo 'usage: hades-embedder-profile [show|list|PROFILE]; profile names use letters, digits, _ or -' >&2
  exit 2
fi
target="$1"
unit="${UNIT_PREFIX}${target}.service"
if [[ ! -f "${PROFILE_DIR}/${target}.conf" ]]; then
  echo "no such profile: $target; use hades-embedder-profile list" >&2
  exit 1
fi
if [[ ! "$READY_TIMEOUT" =~ ^[1-9][0-9]{0,2}$ ]]; then
  echo 'HADES_PROFILE_READY_TIMEOUT must be an integer from 1 to 999 seconds' >&2
  exit 2
fi
# Validate dependencies and serialize selectors before any service mutation.
for dependency in systemctl curl python3 flock; do command -v "$dependency" >/dev/null; done
lock_dir="${XDG_RUNTIME_DIR:-${HOME}/.local/state}/hades"
mkdir -p "$lock_dir"
exec 9>"${lock_dir}/embedder-profile.lock"
if ! flock -n 9; then
  echo 'another embedder profile switch is in progress' >&2
  exit 1
fi
before_active="$(active_units)"
before_enabled="$(enabled_units)"
# A pre-existing multi-active state is ambiguous; do not guess a rollback target.
if [[ $(printf '%s\n' "$before_active" | awk 'NF {n++} END {print n+0}') -gt 1 ]]; then
  echo 'multiple embedder profiles are active; reconcile them in a maintenance window first' >&2
  exit 1
fi

rollback() {
  local failed=0 can_restart=true current current_enabled old state
  echo 'switch failed; restoring prior active profile and boot enablement' >&2
  current="$(active_units)" || { failed=1; can_restart=false; }
  while read -r old; do
    [[ -z "$old" || "$old" == "$before_active" ]] && continue
    systemctl --user stop "$old" || { failed=1; can_restart=false; }
  done <<< "$current"
  current_enabled="$(enabled_units)" || failed=1
  while read -r old state; do
    [[ -z "$old" ]] && continue
    systemctl --user disable "$old" || failed=1
    systemctl --user disable --runtime "$old" || failed=1
  done <<< "$current_enabled"
  while read -r old state; do
    [[ -z "$old" ]] && continue
    if [[ "$state" == enabled-runtime ]]; then
      systemctl --user enable --runtime "$old" || failed=1
    else
      systemctl --user enable "$old" || failed=1
    fi
  done <<< "$before_enabled"
  if [[ -n "$before_active" && "$can_restart" == true ]]; then
    systemctl --user reset-failed "$before_active" || failed=1
    systemctl --user start "$before_active" || failed=1
  fi
  current="$(active_units)" || failed=1
  current_enabled="$(enabled_units)" || failed=1
  if [[ "$current" != "$before_active" || "$current_enabled" != "$before_enabled" ]]; then
    failed=1
  fi
  if (( failed )); then
    echo 'ROLLBACK INCOMPLETE: inspect user units and journals before further switching' >&2
  else
    echo 'prior unit/enablement state restored; inference health still requires verification' >&2
  fi
}
# ERR is not sufficient for signals; every unsuccessful exit after this point
# attempts rollback. SIGKILL/power loss cannot be trapped (see deployment guide).
finish() {
  local status=$?
  trap - EXIT INT TERM
  if (( status != 0 )); then rollback; fi
  exit "$status"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Reconcile persistent and runtime links, including failed-but-enabled instances.
# Selecting the already-active profile leaves its process running.
while read -r old state; do
  [[ -z "$old" ]] && continue
  if [[ "$old" != "$unit" ]]; then systemctl --user disable "$old"; fi
  systemctl --user disable --runtime "$old"
done <<< "$before_enabled"
systemctl --user enable "$unit"
if [[ -n "$before_active" && "$before_active" != "$unit" ]]; then
  systemctl --user stop "$before_active"
fi
if [[ "$before_active" != "$unit" ]]; then
  systemctl --user reset-failed "$unit"
  systemctl --user start "$unit"
fi

# The service still performs its VRAM/device preflight. Never bypass it here.
# Bound the wait and require the requested profile, not any responder on the port.
deadline=$((SECONDS + READY_TIMEOUT))
ready=false
while (( SECONDS < deadline )); do
  if systemctl --user is-active --quiet "$unit" && \
      curl -sf -m 3 "$ENDPOINT" | python3 -c "$PARSE_MODELS" "$target" >/dev/null 2>&1; then
    ready=true
    break
  fi
  sleep 1
done
if [[ "$ready" != true ]]; then
  echo "profile $target did not provide matching metadata within ${READY_TIMEOUT}s; inspect its journal for preflight/startup failure" >&2
  exit 1
fi
# Boot enablement is the persisted selection; there is no second state file.
after_enabled="$(enabled_units)"
after_active="$(active_units)"
if [[ "$after_enabled" != "$unit enabled" || "$after_active" != "$unit" ]]; then
  echo 'profile selection did not converge to exactly one active, persistently enabled instance' >&2
  exit 1
fi
trap - EXIT INT TERM
printf 'selected profile: %s (active and enabled for boot)\n' "$target"
echo 'matching metadata received; inference has not been tested'
