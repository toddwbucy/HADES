# HADES daemon environment. Copy to ~/.config/hades/daemon.env and edit.
# EnvironmentFile wants bare KEY=value: systemd silently discards any line
# with an `export` prefix, and `systemctl show -p Environment` will not show
# you the problem because it reports only inline Environment= directives and
# never expands EnvironmentFile=. Check /proc/<pid>/environ instead.

# --- ArangoDB connection ---------------------------------------------------
# Both sockets may point at the same file. Read/write separation is enforced
# by ArangoDB ACLs on the user, not by HADES.
ARANGO_RO_SOCKET=/run/arangodb3/arangodb.sock
ARANGO_RW_SOCKET=/run/arangodb3/arangodb.sock
ARANGO_USERNAME=hades
# ARANGO_PASSWORD is required unless the server has authentication disabled.
ARANGO_PASSWORD=

# The default database. Every command must name one, and there is no implicit
# fallback, so an unconfigured command fails loudly rather than silently
# touching something shared.
HADES_DATABASE=

# --- MCP endpoint ----------------------------------------------------------
# UNSET BY DEFAULT, ON PURPOSE. With no bind address the daemon serves the
# Unix socket only and opens no network listener.
#
# Set it to expose MCP to other hosts. Loopback or RFC1918 only, and the
# daemon fails closed at startup if the token file is missing or empty.
#
#   HADES_MCP_BIND=127.0.0.1:10443          # this host only
#   HADES_MCP_BIND=<your-lan-ip>:10443      # reachable on your LAN
#
# The endpoint is plain HTTP, not TLS, whatever port you choose. The bearer
# token crosses the network in the clear, so on anything but a trusted LAN
# prefer an SSH tunnel and keep the bind on loopback:
#
#   ssh -N -L 10443:127.0.0.1:10443 <host>
#
# HADES_MCP_BIND=

# Bearer tokens, one per line, mode 0600. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HADES_MCP_TOKEN_FILE=%h/.config/hades/mcp-token

# Databases the endpoint may serve, comma-separated. Anything not listed is
# refused. Writes stay ACL-gated on the ArangoDB user regardless.
# HADES_MCP_DBS=
