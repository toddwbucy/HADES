# HADES Embedder Service Configuration — olympus dev instance.
# Adapted from services/systemd/embedder.conf for a user-level run.
# Sourced as an EnvironmentFile, so bare KEY=value, no `export`.

# GPU visibility. Restricting at the driver level means the other two cards
# are invisible to this process, not merely unselected.
CUDA_VISIBLE_DEVICES=2
HADES_EMBEDDER_DEVICE=cuda:0

HADES_EMBEDDER_HOST=127.0.0.1
HADES_EMBEDDER_PORT=8087

# Model. Pointed at the bulk-store copy, which is byte-identical to the
# pinned 853c867b snapshot (verified by sha256 on both weight shards and the
# adapter). Naming the path directly makes HF_HOME irrelevant.
HADES_EMBEDDER_MODEL=${MODEL_PATH}

# Sequence ceiling. Bisected on this card 2026-09-12 at batch=1: 15000 OK,
# 16000 OOM, 24000 OOM, 30000 OOM. 14000 is set here rather than 15000
# because BATCH_SIZE below is 4, and four sequences share the same ~6 GiB of
# activation headroom the bisect measured with one.
#
# For a document that needs more, move it rather than raising this:
#   CUDA_VISIBLE_DEVICES=0 HADES_EMBEDDER_MAX_TOKENS=32768
# on either A6000 (49 GiB) instead of arguing with a 16 GiB card.
HADES_EMBEDDER_MAX_TOKENS=15000

HADES_EMBEDDER_FP16=true
HADES_EMBEDDER_BATCH_SIZE=4
HADES_EMBEDDER_IDLE_TIMEOUT=900

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
